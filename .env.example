API_PORT=3000
FRONTEND_ORIGIN=http://localhost:4201
# URL pública usada para montar links de convite, sem barra no final.
FRONTEND_PUBLIC_URL=http://localhost:4201
POSTGRES_PORT=5432
REDIS_PORT=6379
PGADMIN_PORT=5050

POSTGRES_DB=musica_da_gloria
POSTGRES_USER=musica_app
POSTGRES_PASSWORD=change-me

PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=change-me

EMAIL_QUEUE_NAME=email-delivery
SESSION_TTL_DAYS=7
# Use true com HTTPS em homologacao/producao; false somente no localhost HTTP.
SESSION_COOKIE_SECURE=false
# Use none somente com HTTPS quando o front e a API estiverem em sites diferentes.
SESSION_COOKIE_SAME_SITE=lax
BOOTSTRAP_ADMIN_NAME=Administrador global
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=change-me-now
# Habilite apenas no primeiro start e desabilite depois que o administrador for criado.
BOOTSTRAP_ADMIN_ENABLED=false
TZ=America/Fortaleza
