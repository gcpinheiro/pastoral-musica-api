{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["catalogVersion", "items"],
  "additionalProperties": false,
  "properties": {
    "catalogVersion": { "const": 1 },
    "items": {
      "type": "array",
      "items": { "$ref": "#/$defs/song" }
    }
  },
  "$defs": {
    "song": {
      "type": "object",
      "required": ["title", "author", "defaultKey", "liturgicalMoments"],
      "additionalProperties": false,
      "properties": {
        "externalId": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "author": { "type": "string", "minLength": 1 },
        "defaultKey": { "type": "string", "minLength": 1 },
        "liturgicalMoments": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "contentMode": { "enum": ["INTERNAL", "EXTERNAL_EMBED"] },
        "lyrics": { "type": "string", "minLength": 1 },
        "chords": { "type": "string", "minLength": 1 },
        "externalUrl": { "type": "string", "format": "uri" },
        "sourceAttribution": { "type": "string", "minLength": 1 },
        "rights": { "$ref": "#/$defs/rights" }
      },
      "allOf": [
        {
          "if": {
            "required": ["contentMode"],
            "properties": { "contentMode": { "const": "EXTERNAL_EMBED" } }
          },
          "then": { "required": ["externalUrl", "sourceAttribution"] },
          "else": { "required": ["lyrics", "chords", "rights"] }
        }
      ]
    },
    "rights": {
      "type": "object",
      "required": ["status", "type", "attribution", "allowsStorage", "allowsLyrics", "allowsChords", "allowsTransposition"],
      "additionalProperties": false,
      "properties": {
        "status": { "enum": ["APPROVED", "PENDING_REVIEW", "REJECTED", "UNREVIEWED"] },
        "type": { "enum": ["PUBLIC_DOMAIN", "CC0", "CC_BY", "CC_BY_SA", "PARISH_PROVIDED"] },
        "sourceUrl": { "type": "string", "format": "uri" },
        "proofUrl": { "type": "string", "format": "uri" },
        "sourceDocument": { "type": "string", "minLength": 1 },
        "attribution": { "type": "string", "minLength": 1 },
        "territory": { "type": "string", "minLength": 2 },
        "allowsStorage": { "const": true },
        "allowsLyrics": { "const": true },
        "allowsChords": { "const": true },
        "allowsTransposition": { "const": true },
        "reviewedAt": { "type": "string", "format": "date-time" }
      },
      "allOf": [
        {
          "if": { "properties": { "type": { "const": "PARISH_PROVIDED" } } },
          "then": { "required": ["sourceDocument"] },
          "else": { "required": ["sourceUrl", "proofUrl"] }
        }
      ]
    }
  }
}
